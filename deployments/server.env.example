# Copy to /etc/tomchat/server.env and protect it with chmod 600.
TOMCHAT_LISTEN_ADDR=127.0.0.1:8080
TOMCHAT_DATABASE_URL=postgres://tomchat:CHANGE_ME@127.0.0.1:5432/tomchat?sslmode=disable
TOMCHAT_REGISTRATION_ENABLED=false
# Set both only on the first startup against an empty database, then remove them.
TOMCHAT_BOOTSTRAP_ADMIN_USERNAME=admin
TOMCHAT_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
