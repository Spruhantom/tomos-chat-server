[Unit]
Description=TomChat Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tomchat
Group=tomchat
EnvironmentFile=-/etc/tomchat/server.env
ExecStart=/usr/bin/tomchat-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tomchat

[Install]
WantedBy=multi-user.target
